node_modules/
dist/
coverage/
*.tsbuildinfo

*.log
.env
.env.*
.claude/settings.local.json
.DS_Store
Thumbs.db

# Unsanitized captures from a real machine. Fixtures under fixtures/ are
# sanitized by hand and reviewed; anything else stays local.
*.raw.json
*.raw.jsonl
fixtures/local/

# Local pack artifacts from "npm pack".
*.tgz

# The Rust half: build output, and the npm bundle staged for the Tauri bundler.
target/
# A second Cargo target directory, for when CARGO_TARGET_DIR is pointed away from
# target/ so a long bundler build and a quick "cargo test" do not evict each other.
target-alt/
apps/desktop/resources/
apps/desktop/gen/
# Written by tauri-build from the command list in apps/desktop/build.rs, on every
# build, before anything reads them. Committing them would only create a way for
# the generated file and the list that generates it to disagree.
apps/desktop/permissions/autogenerated/
apps/desktop/icons/bead-1024.png
