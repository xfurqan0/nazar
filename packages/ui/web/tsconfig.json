{
  "//": "The browser half. Separate from ../tsconfig.json because this code needs the DOM lib and must not see Node's types; it is bundled by build.mjs and never emitted by tsc.",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["./*.ts", "../src/**/*.ts"]
}
